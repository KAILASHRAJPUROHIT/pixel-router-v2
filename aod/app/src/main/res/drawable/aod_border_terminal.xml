<?xml version="1.0" encoding="utf-8"?>
<!-- Stroke-only, sharp-cornered outline for the terminal/HUD/mission-
     control style layouts (Cyberpunk Terminal, Matrix AOD, Space
     Mission Control, Jarvis HUD) - no solid fill, since tintPanelIfPresent
     applies one uniform setTint() color to the whole drawable, and a
     clean bordered-outline look (not a filled card) is what these
     styles are going for. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="3dp" />
    <stroke android:width="1dp" android:color="#333333" />
</shape>
