<?xml version="1.0" encoding="utf-8"?>
<!-- Borderless, unfilled stat card for the One UI / OnePlus minimal
     styles (One UI Minimal, Samsung One UI Information/Compact,
     OnePlus Minimal) - same grid proportions as aod_card_stat.xml but
     no background at all, just clean spacing (this is what stock
     Samsung/OnePlus AOD widgets actually look like: no boxed cards). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:alpha="0.6"
        android:text="Label" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="13sp"
        android:autoSizeMaxTextSize="60sp"
        android:autoSizeStepGranularity="1sp"
        android:text="--" />

</LinearLayout>
