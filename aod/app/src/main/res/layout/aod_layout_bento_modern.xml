<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:fontFamily="sans-serif-light"
            android:text="--:--" />

        <TextView
            android:id="@+id/health_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:gravity="end"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:text="--" />
    </LinearLayout>

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="---" />

    <!-- Panchang + weather cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/panchang_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.7"
            android:layout_margin="4dp"
            android:background="@drawable/aod_card_bg_modern"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/panchang_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:text="Hindu calendar" />

            <TextView
                android:id="@+id/panchang_tithi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="22sp"
                android:text="---" />

            <TextView
                android:id="@+id/panchang_nakshatra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="---" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/aod_card_bg_modern"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="28sp"
                android:text="--°" />

            <TextView
                android:id="@+id/weather_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:maxLines="2"
                android:text="---" />
        </LinearLayout>
    </LinearLayout>

    <!-- Down + Battery (prominent) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_stat" android:id="@+id/row0" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row4" />
    </LinearLayout>

    <!-- Devices, Signal, Internet -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_stat" android:id="@+id/row2" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row9" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row8" />
    </LinearLayout>

    <!-- Up, Thermal, Skin Temp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_stat" android:id="@+id/row1" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row5" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row6" />
    </LinearLayout>

    <!-- Total Used (wide), SMS Fwd -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_stat" android:id="@+id/row3"
            android:layout_width="0dp" android:layout_weight="2.2" />
        <include layout="@layout/aod_card_stat" android:id="@+id/row7" />
    </LinearLayout>

</LinearLayout>
