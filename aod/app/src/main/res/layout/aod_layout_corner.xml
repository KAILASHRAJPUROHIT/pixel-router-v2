<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top-left: clock + date + health. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="62sp"
            android:fontFamily="sans-serif-light"
            android:text="--:--" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="2dp"
            android:text="---" />

        <TextView
            android:id="@+id/health_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textAllCaps="true"
            android:layout_marginTop="12dp"
            android:text="--" />
    </LinearLayout>

    <!-- Top-right: perf/net/panchang/muhurat, right-aligned - previously
         crammed under the clock in the top-left corner leaving the
         top-right corner unused entirely. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/perf_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:alpha="0.6"
            android:text="--" />

        <TextView
            android:id="@+id/net_type_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="--" />

        <TextView
            android:id="@+id/akd_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:text="--" />

        <!-- maxWidth caps how far these two variable-length lines can
             grow toward the top-left corner - the clock is large enough
             (62sp) that unconstrained long panchang/muhurat text could
             still reach it otherwise. Confirmed as a real overlap bug
             via screenshot 2026-07-06 at 76sp before this fix. -->
        <TextView
            android:id="@+id/panchang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            android:text="---" />

        <TextView
            android:id="@+id/muhurat_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="180dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:text="--" />
    </LinearLayout>

    <!-- Bottom-left: first 5 stats, start-aligned. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="28dp"
        android:orientation="vertical">

        <include layout="@layout/aod_row_start" android:id="@+id/row0" />
        <include layout="@layout/aod_row_start" android:id="@+id/row1" />
        <include layout="@layout/aod_row_start" android:id="@+id/row2" />
        <include layout="@layout/aod_row_start" android:id="@+id/row3" />
        <include layout="@layout/aod_row_start" android:id="@+id/row4" />
    </LinearLayout>

    <!-- Bottom-right: remaining 5 stats, end-aligned. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="28dp"
        android:orientation="vertical">

        <include layout="@layout/aod_row_end" android:id="@+id/row5" />
        <include layout="@layout/aod_row_end" android:id="@+id/row6" />
        <include layout="@layout/aod_row_end" android:id="@+id/row7" />
        <include layout="@layout/aod_row_end" android:id="@+id/row8" />
        <include layout="@layout/aod_row_end" android:id="@+id/row9" />
    </LinearLayout>

</FrameLayout>
