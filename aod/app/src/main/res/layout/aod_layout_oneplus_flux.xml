<?xml version="1.0" encoding="utf-8"?>
<!-- OnePlus Accent (Clean & Bold) - rounded cards with a small
     accent-color dot per stat. Complete field set, same skeleton as
     bento_modern.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="42sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:text="--:--" />

        <TextView
            android:id="@+id/net_type_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:gravity="end"
            android:textSize="11sp"
            android:text="--" />

        <TextView
            android:id="@+id/akd_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="top"
            android:gravity="end"
            android:textSize="11sp"
            android:text="--" />
    </LinearLayout>

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:text="---" />

    <TextView
        android:id="@+id/perf_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:alpha="0.6"
        android:text="--" />

    <TextView
        android:id="@+id/muhurat_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="--" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:padding="14dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/aod_circle_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:alpha="0.6"
            android:letterSpacing="0.05"
            android:text="Flux" />

        <TextView
            android:id="@+id/health_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="34sp"
            android:text="--" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/panchang_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.7"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/panchang_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:text="Hindu calendar" />

            <TextView
                android:id="@+id/panchang_tithi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="22sp"
                android:text="---" />

            <TextView
                android:id="@+id/panchang_nakshatra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="---" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="28sp"
                android:text="--°" />

            <TextView
                android:id="@+id/weather_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:maxLines="2"
                android:text="---" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_bold" android:id="@+id/row0" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row4" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_bold" android:id="@+id/row2" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row9" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row8" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_bold" android:id="@+id/row1" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row5" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row6" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal">
        <include layout="@layout/aod_card_bold" android:id="@+id/row3"
            android:layout_width="0dp" android:layout_weight="2.2" />
        <include layout="@layout/aod_card_bold" android:id="@+id/row7" />
    </LinearLayout>

</LinearLayout>
