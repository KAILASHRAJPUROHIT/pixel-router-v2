<?xml version="1.0" encoding="utf-8"?>
<!-- One UI Minimal (Samsung style) - single-line inline rows: a small
     color dot, the label, then the value right-aligned on the SAME
     line (not stacked label-above-value like every other layout) -
     genuinely distinct structure from the other Samsung/OnePlus
     layouts, matching the reference's thin clean single-line list.
     Complete field set: all ten stats + health/net/perf/akd badges +
     panchang + weather. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:text="---" />
<TextView android:id="@+id/akd_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="16sp" android:textStyle="bold" android:text="--" />

        <TextView
            android:id="@+id/health_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textColor="#2ecc71"
            android:text="--" />
    </LinearLayout>

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="46sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginTop="2dp"
        android:text="--:--" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/net_type_badge"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="10sp" android:alpha="0.7" android:text="--" />
        </LinearLayout>
    <TextView
        android:id="@+id/perf_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="9sp" android:alpha="0.5" android:text="--" />
    <TextView
        android:id="@+id/muhurat_badge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textStyle="bold" android:visibility="gone" android:text="--" />

    <LinearLayout
        android:id="@+id/panchang_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <TextView
            android:id="@+id/panchang_header"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:alpha="0.6" android:text="Calendar" />
        <TextView
            android:id="@+id/panchang_tithi"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textStyle="bold" android:textSize="13sp" android:text="---" />
        <TextView
            android:id="@+id/panchang_nakshatra"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textSize="12sp" android:alpha="0.7" android:text="---" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/weather_card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="2dp">
        <TextView
            android:id="@+id/weather_temp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textStyle="bold" android:textSize="13sp" android:text="--°" />
        <TextView
            android:id="@+id/weather_condition"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textSize="12sp" android:alpha="0.7" android:text="---" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginVertical="14dp" android:alpha="0.15" android:background="#ffffff" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row8" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#2ecc71" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Internet" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#2ecc71" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row0" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#3498db" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Download" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#3498db" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row1" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#f39c12" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Upload" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#f39c12" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row2" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#9b59b6" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Devices" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#9b59b6" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row4" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#2ecc71" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Battery" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#2ecc71" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row5" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#e67e22" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Thermal" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#e67e22" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row6" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#e74c3c" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Skin temp" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#e74c3c" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row3" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#16a085" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Total used" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#16a085" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row7" android:layout_marginBottom="14dp">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#e91e63" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="SMS fwd" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#e91e63" android:text="--" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:id="@+id/row9">
        <View android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:background="#00bcd4" />
        <TextView android:id="@+id/stat_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_gravity="center_vertical" android:textSize="14sp" android:text="Signal" />
        <TextView android:id="@+id/stat_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp" android:textColor="#00bcd4" android:text="--" />
    </LinearLayout>

</LinearLayout>
