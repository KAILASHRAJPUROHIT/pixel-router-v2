<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/rail_bg"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp">

        <include layout="@layout/aod_row_rail" android:id="@+id/row0" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row1" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row2" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row3" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row4" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row5" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row6" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row7" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row8" />
        <include layout="@layout/aod_row_rail" android:id="@+id/row9" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:fontFamily="sans-serif-light"
            android:text="--:--" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="---" />

        <TextView
            android:id="@+id/health_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:layout_marginBottom="24dp"
            android:text="--" />

        <TextView
            android:id="@+id/headline1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:text="Battery" />

        <TextView
            android:id="@+id/headline1_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:text="--" />

        <TextView
            android:id="@+id/headline2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:text="Internet" />

        <TextView
            android:id="@+id/headline2_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="--" />

    </LinearLayout>

</LinearLayout>
