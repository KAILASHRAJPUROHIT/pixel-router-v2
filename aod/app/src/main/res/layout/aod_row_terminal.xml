<?xml version="1.0" encoding="utf-8"?>
<!-- Bordered "console line" row for the terminal/HUD/mission-control
     styles - label above value, both inside aod_border_terminal's
     outline box, monospace throughout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/aod_border_terminal"
    android:padding="8dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:alpha="0.7"
        android:text="Label" />

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp"
        android:text="--" />

</LinearLayout>
