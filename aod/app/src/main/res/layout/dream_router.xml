<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8FD3FF"
        android:textSize="68sp"
        android:fontFamily="sans-serif-light"
        android:text="--:--" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#787E8C"
        android:textSize="15sp"
        android:layout_marginTop="2dp"
        android:text="---" />

    <!-- Prominent, always-visible connectivity status pills -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/status_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="#0B0C10"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="● Online" />

        <TextView
            android:id="@+id/status_signal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="#0B0C10"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Signal: --" />

    </LinearLayout>

    <TextView
        android:id="@+id/conn_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#3A3D46"
        android:textSize="11sp"
        android:layout_marginTop="8dp"
        android:text="connecting..." />

    <!-- Stat card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="22dp">

        <include layout="@layout/dream_stat_row" android:id="@+id/row_down" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_up" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_devices" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_total" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_battery" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_thermal" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_skintemp" />
        <include layout="@layout/dream_stat_row" android:id="@+id/row_smsfwd" />

    </LinearLayout>

</LinearLayout>
